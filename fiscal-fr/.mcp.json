{
  "mcpServers": {
    "fiscal-fr-local": {
      "command": "node",
      "args": [
        "-e",
        "require(require('path').join(process.cwd(), 'fiscal-fr', 'start-mcp.js'))"
      ],
      "env": {
        "MCP_PROFILE": "debug",
        "MCP_LOG_FILE": "./logs/mcp-server-{date}.log",
        "MCP_LOG_STDERR": "true"
      }
    }
  }
}
