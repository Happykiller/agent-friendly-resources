{
  "name": "fiscal-fr-mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "MCP_TRANSPORT=http tsx --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json && npm run copy:data",
    "copy:data": "mkdir -p dist/data && cp src/data/*.json dist/data/",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "inversify": "^7.10.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
