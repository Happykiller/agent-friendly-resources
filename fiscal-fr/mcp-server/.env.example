MCP_PORT=3333
MCP_LOG_LEVEL=debug
MCP_LOG_FILE=../logs/mcp-server-{date}.log
MCP_LOG_STDERR=true
MCP_LOG_ROTATE_DAILY=true
# Compte par défaut si MCP_AUTH_REQUIRED=false (dev local sans auth)
# MCP_HTTP_ACCOUNT=moncompte

# Auth — OAuth 2.0 + API Key
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=<32+ caractères aléatoires>
# OAUTH_ISSUER=https://votre-domaine.com
# MCP_AUTH_REQUIRED=true   # false pour désactiver l'auth en dev local
